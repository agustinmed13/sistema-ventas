# Modelo de variables de entorno.
# Copiar este archivo como .env.local y completar los valores:
#   cp .env.example .env.local
# .env.local NUNCA se sube al repositorio. En producción, las variables
# de Turso se cargan en Vercel (Settings -> Environment Variables).

# Dirección de la base de datos en Turso. Empieza con libsql://
# Se obtiene en el panel de Turso o con: turso db show <nombre-de-la-base> --url
TURSO_DATABASE_URL=

# Token de acceso a esa base de datos.
# Se obtiene en el panel de Turso o con: turso db tokens create <nombre-de-la-base>
TURSO_AUTH_TOKEN=

# Contraseña del usuario admin@mostrador.com.
# Solo la usa el script de datos de prueba (npm run db:seed), que guarda su hash.
ADMIN_PASSWORD=

# Contraseña del usuario vendedor@mostrador.com.
# Solo la usa el script de datos de prueba (npm run db:seed), que guarda su hash.
VENDEDOR_PASSWORD=
